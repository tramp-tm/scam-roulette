{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    /* ИСПРАВЛЕНО: Современный стандарт для ESM */
    "moduleResolution": "bundler",

    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* ИСПРАВЛЕНО: Позволяет tsc нормально генерировать код с moduleResolution: bundler */
    "isolatedModules": false,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "declaration": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
