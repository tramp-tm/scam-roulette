{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "declaration": false
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist"]
}